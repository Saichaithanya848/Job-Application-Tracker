# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Local: mongodb://localhost:27017/job_tracker
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/job_tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/job_tracker

# JWT Secret Key (Replace with a strong random string in production)
JWT_SECRET=super_secret_job_tracker_jwt_key_2026

# JWT Expiration
JWT_EXPIRES_IN=7d

# Environment
NODE_ENV=development
